# Exact pins for anything added later, and no dependency runs code at install.
save-exact=true
ignore-scripts=true
# Resolve only versions published at least 7 days ago (in minutes), so a
# freshly hijacked release never lands in the lockfile. @nebari/starlight
# 1.4.0 is excepted: checked by hand against its signed GitHub release.
minimum-release-age=10080
minimum-release-age-exclude[]=@nebari/starlight
