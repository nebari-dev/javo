---
// Replaces the theme's footer so the splash pages (home, 404) carry Javo's
// own mark and links instead of the Nebari project's. Doc pages keep
// Starlight's default footer (edit link, pagination) only, as in the theme.
import Default from '@astrojs/starlight/components/Footer.astro';
import config from 'virtual:starlight/user-config';

const { hasSidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const local = (href: string) => `${base}${href}`;
const repo = 'https://github.com/nebari-dev/javo';

const columns = [
  {
    title: 'Documentation',
    links: [
      { label: 'Get started', href: local('/getting-started/') },
      { label: 'Use Javo', href: local('/using/') },
      { label: 'Administer', href: local('/admin/') },
      { label: 'Reference', href: local('/reference/') },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: repo },
      { label: 'Contributing', href: local('/contributing/') },
      { label: 'Security', href: local('/contributing/security/') },
    ],
  },
];
---
<Default><slot /></Default>
{!hasSidebar && (
<div class="javo-footer">
  <div class="javo-footer__top">
    <div class="javo-footer__brand">
      <img src={local('/brand/javo-logo.svg')} alt="Javo" class="javo-footer__mark--light" />
      <img src={local('/brand/javo-logo-white.svg')} alt="Javo" class="javo-footer__mark--dark" />
      {config.description && <p>{config.description}</p>}
    </div>
    <div class="javo-footer__cols">
      {columns.map((column) => (
        <div>
          <p class="javo-footer__col-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="javo-footer__bar">
    <span>Open source under the Apache License 2.0</span>
    <a href="https://starlight.astro.build">Built with Astro Starlight</a>
  </div>
</div>
)}
<style>
  .javo-footer {
    margin-top: 3rem;
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--sl-color-hairline);
    padding-block: 2rem 0;
    padding-inline: calc(50vw - 50%);
    background-color: var(--nbr-surface-subtle);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  :global(main:has(.javo-footer)),
  :global(.content-panel:has(.javo-footer)) {
    padding-bottom: 0;
  }
  .javo-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .javo-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 20rem;
  }
  .javo-footer__brand img {
    width: auto;
    height: 1.75rem;
    align-self: flex-start;
  }
  .javo-footer__brand p { margin: 0; }
  .javo-footer__mark--dark { display: none; }
  :global(:root[data-theme='dark']) .javo-footer__mark--light { display: none; }
  :global(:root[data-theme='dark']) .javo-footer__mark--dark { display: inline; }
  .javo-footer__cols {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
  }
  .javo-footer__col-title {
    margin: 0 0 0.5rem;
    color: var(--sl-color-white);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .javo-footer ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .javo-footer a { color: inherit; text-decoration: none; }
  .javo-footer a:hover { color: var(--sl-color-text-accent); text-decoration: underline; }
  .javo-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
    padding-block: 1rem;
  }
</style>
