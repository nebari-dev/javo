{
  "name": "javo-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-apidocs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:api": "pnpm -C tools/gen-api install --frozen-lockfile --ignore-scripts && pnpm -C tools/gen-api gen",
    "mock": "vite --config vite.mock.config.ts",
    "check:layout": "node tools/layout-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@tanstack/react-query": "5.104.3",
    "anser": "2.3.5",
    "boring-avatars": "2.0.4",
    "cmdk": "1.1.1",
    "cronstrue": "3.32.0",
    "downshift": "9.4.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "swagger-ui-dist": "5.33.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@shikijs/vscode-textmate": "10.0.2",
      "hast-util-to-html": "9.0.5",
      "unist-util-visit": "5.1.0",
      "unist-util-visit-parents": "6.0.2",
      "@scarf/scarf": "-"
    }
  }
}
