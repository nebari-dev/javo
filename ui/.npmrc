# Exact pins for anything added later, and no dependency runs code at install.
save-exact=true
ignore-scripts=true
# Refuse a package whose engines field excludes the Node in use (CI and the
# image build use Node 22.23.4).
engine-strict=true
# Resolve only versions published at least 7 days ago (in minutes), so a
# freshly hijacked release never lands in the lockfile.
minimum-release-age=10080
